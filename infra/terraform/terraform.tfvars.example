# Copy to terraform.tfvars and fill in, or pass these via TF_VAR_* env vars
# in CI (see .github/workflows/cd.yml). Never commit real secrets here.

aws_region   = "us-east-1"
project_name = "ai-code-review"
environment  = "production"

domain_name         = "" # e.g. "app.example.com" — leave blank to use the ALB DNS name
acm_certificate_arn = "" # leave blank to serve HTTP only until DNS/ACM is set up

# Sensitive — set via TF_VAR_db_password / TF_VAR_app_secret_key instead of
# writing real values into this file.
# db_password    = "..."
# app_secret_key = "..."
